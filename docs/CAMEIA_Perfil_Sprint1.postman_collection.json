  "item": [
    {
      "name": "CM-16 — Crear perfil profesional",
      "item": [
        {
          "name": "OK POST /profiles — crea perfil nuevo (guarda profileId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tiene id', () => pm.expect(pm.response.json().id).to.be.a('string'));",
                  "pm.test('Status IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));",
                  "pm.test('reviewStatus PENDING_REVIEW', () => pm.expect(pm.response.json().reviewStatus).to.eql('PENDING_REVIEW'));",
                  "pm.test('targetRoles es array vacio', () => pm.expect(pm.response.json().targetRoles).to.eql([]));",
                  "pm.collectionVariables.set('profile_id', pm.response.json().id);",
                  "console.log('profileId guardado:', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/profiles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles"
              ]
            }
          }
        },
        {
          "name": "OK GET /profiles/{id} — perfil recién creado vacío",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));",
                  "pm.test('Sin nombre ni resumen', () => { pm.expect(pm.response.json().name).to.eql(null); pm.expect(pm.response.json().summary).to.eql(null); });",
                  "pm.test('Listas vacías', () => ['targetRoles', 'workExperiences', 'educations', 'profileSkills'].forEach(k => pm.expect(pm.response.json()[k]).to.eql([])));",
                  "pm.test('Sin método de creación', () => pm.expect(pm.response.json()).to.not.have.property('method'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/profiles/{{profile_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles",
                "{{profile_id}}"
              ]
            }
          }
        },
        {
          "name": "ERR POST /profiles — 409 cupo del Plan Free alcanzado",
          "event": [
