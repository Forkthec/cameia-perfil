<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Microservicio de Perfil Profesional de CAMEIA.
    Un solo modulo Maven por repositorio, con ArchUnit para verificar las capas
    (reglas de codigo backend, seccion 3.5).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>co.edu.unicauca.cameia</groupId>
  <artifactId>cameia-perfil</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>cameia-perfil</name>
  <description>Microservicio de Perfil Profesional de CAMEIA</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>3.1.1</springdoc.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <dependencies>

    <!-- Perfil expone 12 operaciones HTTP en Sprint 1 (familias de endpoints, seccion 9).
         Se usa 'webmvc' y no 'web': en Spring Boot 4.1.1 el POM de spring-boot-starter-web
         declara "deprecated in favor of spring-boot-starter-webmvc". -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- La validacion de formato vive en presentation.dto (reglas de codigo, seccion 4).
         HU-2.3 y HU-2.4 exigen revalidar obligatoriedad y fechas en backend. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Componente "Repository Perfil Profesional" del C3: Spring Repository sobre JPA/Hibernate. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Contenedor "DB Perfil" del C2/C3: PostgreSQL 16, base y rol propios. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- La plantilla .env.example exige MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info.
         Reglas de codigo 13: todo microservicio expone health e info. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- DEV-IN-07: con spring.jpa.hibernate.ddl-auto=validate hace falta una herramienta de
         migraciones; sin ella el servicio no arranca contra una base vacia con entidades.
         Spring Boot 4 trae starter propio de Flyway. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- API-TBD-14: sin esquemas "Backend, Gateway y Web no pueden integrarse de manera
         independiente". La linea 3.x de springdoc es la que apunta a Spring Boot 4. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Mensajería asíncrona entre microservicios vía RabbitMQ (C2, CONFIRMADO).
         Los stubs iniciales están en infrastructure.messaging — implementación POSTERIOR. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>

    <!-- JUnit 5, AssertJ y Mockito (reglas de codigo, seccion 12). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>


    <!-- Verifica las reglas de dependencia entre capas de la seccion 3.4 de las reglas de
         codigo. "No con revision visual": es la unica forma de que sobrevivan al sprint 3. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Cobertura Java para el pipeline de CI. prepare-agent instrumenta el bytecode
           durante las pruebas; report genera el informe en target/site/jacoco/.
           El gate de bloqueo (umbral 70 %) se activa solo cuando el porcentaje real lo cumpla. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
