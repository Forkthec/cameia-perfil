# Catalogo de variables de cameia-perfil.
#
# Derivado de 03092026_v1_env-example-microservicio-spring.md, seccion "Base comun".
# Se conservan unicamente las secciones que este servicio usa realmente: quedan fuera
# RabbitMQ, Firebase, proveedor LLM, Langfuse, Wompi y dependencias HTTP internas.
#
# Reglas (propuesta multirepo, seccion 6):
#   - Este archivo se versiona. El .env real NO: esta ignorado en .gitignore.
#   - Los valores sensibles quedan VACIOS. Nunca tokens, contrasenas ni llaves.
#   - Que una integracion aparezca aqui no la activa.

# Identidad del servicio.
SPRING_APPLICATION_NAME=cameia-perfil
SPRING_PROFILES_ACTIVE=local

# Puerto. VACIO A PROPOSITO: es DEV-IN-05 y lo asigna quien arma la matriz
# ruta -> servicio del API Gateway. Sin valor, el servicio usa 8082, que es
# PROVISIONAL: sale del ejemplo local de la plantilla del Gateway
# (PERFIL_BASE_URL=http://localhost:8082) y el documento multirepo aclara que
# esos puertos "no constituyen una decision arquitectonica aprobada".
SERVER_PORT=

# PostgreSQL: una base y un usuario independientes por contexto.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cameia_perfil
SPRING_DATASOURCE_USERNAME=cameia_perfil
SPRING_DATASOURCE_PASSWORD=

# Persistencia. El esquema lo gobiernan las migraciones de Flyway, no Hibernate.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Operacion basica.
LOG_LEVEL=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info


# ---------------------------------------------------------------------------
# Solo para Docker Compose. NO las lee la aplicacion.
#
# Estan aparte a proposito: la seccion de arriba responde DEV-IN-04, que pide
# "variables realmente consumidas por el codigo". Estas no lo son; las lee
# docker-compose.yml para levantar el contenedor de PostgreSQL.
#
# Si no creas un .env, Compose usa sus valores por defecto y todo funciona.
# ---------------------------------------------------------------------------

POSTGRES_DB=cameia_perfil
POSTGRES_USER=cameia_perfil

# Contrasena del contenedor local de PostgreSQL. Vacia aqui, como toda variable
# sensible. Si no la defines, Compose usa 'cameia_local', que es una credencial
# de desarrollo de un contenedor que solo escucha en localhost.
POSTGRES_PASSWORD=

# Puerto en el que se publica PostgreSQL en tu maquina. Cambialo si ya tienes
# otro Postgres ocupando el 5432.
POSTGRES_PORT=5432
